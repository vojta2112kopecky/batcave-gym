<?xml version="1.0" encoding="UTF-8"?>
<!--
  Volitelný autostart serveru po přihlášení do Macu.
  NENÍ nainstalováno – zapneš to jedním příkazem:

    cp ~/trenink_app/autostart.plist ~/Library/LaunchAgents/cz.batcave.gym.plist
    launchctl load ~/Library/LaunchAgents/cz.batcave.gym.plist

  Vypnutí:
    launchctl unload ~/Library/LaunchAgents/cz.batcave.gym.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cz.batcave.gym</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/vojtech/trenink_app/server.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/batcave-gym.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/batcave-gym.err</string>
</dict>
</plist>
